# Contact form (/contact). Copy to .env.local and fill in; never commit real keys.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Website <hello@yourdomain.com>"
# Where the messages land.
CONTACT_TO_EMAIL=you@example.com

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is public and ships to the browser; the secret key must not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
