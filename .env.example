# Contact form (/contact). Copy to .env.local and fill in; never commit real keys.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, e.g. "Website <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Where the messages land.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is public and ships to the browser; the secret must not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated hosts allowed to solve the challenge. Leave empty to skip the
# check. Entries are exact, or a wildcard like *.vercel.app — which you want,
# because Vercel gives every preview deployment a brand new hostname.
# e.g. arnabmajumdar.com,www.arnabmajumdar.com,*.vercel.app,localhost
TURNSTILE_HOSTNAMES=
